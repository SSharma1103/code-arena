AGENT_PORT=3001
# Match apps/code-arena/.env.local. This local default is for development.
AGENT_INTERNAL_SECRET=code-arena-local-development
# API and video worker must use the same absolute directory on a local disk.
# VIDEO_EXPORT_DIR=C:/codeall/code-arena/apps/agent/.data/exports
# FFmpeg with libx264, or an absolute executable path.
# FFMPEG_PATH=ffmpeg
# Optional installed browser channel (chrome or msedge); otherwise Playwright Chromium.
# VIDEO_CHROMIUM_CHANNEL=chrome
# Optional alternate Playwright browser cache (use the same value when installing).
# PLAYWRIGHT_BROWSERS_PATH=C:/codeall/code-arena/.data/browsers
