AGENT_API_URL=http://127.0.0.1:3001
# Use the same secret in apps/agent/.env. This local default is for development.
AGENT_INTERNAL_SECRET=code-arena-local-development

# Firebase web app (Firebase Console > Project settings > Your apps).
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=

# Server only: Firebase Admin service account (never use NEXT_PUBLIC_ here).
# Alternatively, configure Application Default Credentials on the server.
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY=
